* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f4f7fb;
    color: #203047;
}

header {
    background: #153b5b;
    color: white;
    padding: 20px;
}

header h2 {
    margin: 0 0 5px;
}

nav {
    background: white;
    padding: 15px;
}

nav a {
    text-decoration: none;
    color: #1769aa;
    margin-right: 20px;
}

nav a:hover {
    color: #c0392b;
}

main {
    padding: 20px;
}

.card {
    background: white;
    padding: 20px;
    margin: 10px 0;
    border-radius: 10px;
    box-shadow: 0 2px 5px #ddd;
}

.normal {
    color: green;
}

.abnormal {
    color: red;
}

button {
    background: #1769aa;
    color: white;
    border: none;
    padding: 10px 15px;
    border-radius: 5px;
    cursor: pointer;
}

input, select, textarea {
    padding: 10px;
    margin: 5px 0 12px;
    width: 100%;
}
